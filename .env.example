MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=linux_notes

# Shared access string (exactly 9 characters). Never commit a real value.
ENOTES_ACCESS_KEY=abc123XYZ

# Separate random secret used to sign access-session cookies (at least 32 characters).
ENOTES_SESSION_SECRET=replace-with-a-separate-random-secret-of-32-characters-minimum

# Server-side Gemini key; never expose it to browser code or commit a real value.
GEMINI_API_KEY=
# Optional model override (defaults to gemini-3.8-flash).
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Private Vercel Blob store for the optional Image & PDF Library.
# Connect the private store to this Vercel project; OIDC auth is injected by Vercel.
OGE_STORE_ID=
# Optional only if a future upload flow uses Vercel Blob completion webhooks.
OGE_WEBHOOK_PUBLIC_KEY=
