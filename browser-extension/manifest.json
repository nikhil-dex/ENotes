{
  "manifest_version": 3,
  "name": "ENotes Quick Note",
  "version": "0.1.0",
  "description": "Capture quick notes from any website and save them to your private ENotes Quick Notes.",
  "key": "",
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "ENotes Quick Note",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
